<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/widget_table" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/widget_date" android:layout_marginEnd="8dp"
        android:ellipsize="end" android:maxLines="1" android:textSize="12sp" />
    <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/widget_week_count" android:layout_marginEnd="4dp"
        android:maxLines="1" android:textSize="12sp" />
    <TextView android:id="@+id/widget_week_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/widget_week" android:layout_marginEnd="4dp"
        android:maxLines="1" android:textSize="12sp" />
    <TextView android:id="@+id/widget_week" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_alignParentEnd="true" android:maxLines="1" android:textSize="12sp" />
</RelativeLayout>
